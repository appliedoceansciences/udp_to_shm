[Unit]
Description=udp_to_shm
Conflicts=cobs_to_shm.service
Before=network.target

[Service]
Type=simple
Restart=always
RestartSec=4
CPUAffinity=0
ExecStart=/usr/local/bin/udp_to_shm --hardlink cobs_to_shm --heartbeat 192.168.7.1
ExecStopPost=rm -rf /dev/shm/cobs_to_shm /dev/shm/acoustic_packets

LimitNICE=-20

[Install]
WantedBy=multi-user.target
